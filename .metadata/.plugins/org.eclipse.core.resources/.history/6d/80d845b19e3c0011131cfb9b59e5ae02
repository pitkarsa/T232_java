package com.itvedant.flight_data_management.model;

import java.time.LocalDateTime;

public class Flight {
	
	private String flightNo, airlineName, source, destination, duration;
	LocalDateTime departure, arrival;
	double ticketPrice;
	
	public Flight(String flightNo, String airlineName, String source, String destination, String duration,
			LocalDateTime departure, LocalDateTime arrival, double ticketPrice) {
		this.flightNo = flightNo;
		this.airlineName = airlineName;
		this.source = source;
		this.destination = destination;
		this.duration = duration;
		this.departure = departure;
		this.arrival = arrival;
		this.ticketPrice = ticketPrice;
	}
	@Override
	public String toString() {
		return "Flight [flightNo=" + flightNo + ", airlineName=" + airlineName + ", source=" + source + ", destination="
				+ destination + ", duration=" + duration + ", departure=" + departure + ", arrival=" + arrival
				+ ", ticketPrice=" + ticketPrice + "]";
	}
}
