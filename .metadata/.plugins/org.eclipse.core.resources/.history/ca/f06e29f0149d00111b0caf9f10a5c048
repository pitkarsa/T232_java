package day1;

import java.util.ArrayList;
import java.util.Collection;

public class Collection1 {
	public static void main(String[] args) {
		// collection is a way to store multiple object s into a single object
		
		// array is static - collection is dynamic 
		// collection is growable and shrinkable
		
		// inbuilt methods for DML
		
		// heterogenous structure
		Collection c = new ArrayList<>();
		c.add("Hi");
		c.add(100);
		c.add(10.67576);
		c.add('a');
		System.out.println(c);
		
		
		// generic collection (homogenous collection)
		Collection<Integer> numbers = new ArrayList<>();		
		numbers.add(19);
		numbers.add(-677);
		numbers.add(null);
//		numbers.add("jhjkjj");
//		numbers.add(1898.4546);
		System.out.println(numbers);
		
		Collection<String> names = new ArrayList<>();
		names.add("Amit");
		names.add("Java");
		names.add(null);
		names.add("6766678");
		names.add(7867676);
		names.add('R');
		names.add(null);
		System.out.println(names);
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
	}
}
