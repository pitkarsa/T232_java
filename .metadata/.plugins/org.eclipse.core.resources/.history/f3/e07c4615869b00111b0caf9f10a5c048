package day1;

public class Demo1 extends Thread {
	
	public static void main(String[] args) {
		// parallel execution
		Thread d1 = new Demo1();// thread
		Thread d2 = new Demo1();// thread
		d1.start(); // starting the thread, it calls d1.run() 
		d2.start(); // starting the thread, it calls d2.run()
		d1.setName("first");
		d2.setName("second");
		// 1 min
		// 10 max
		// 5 norm
		d1.setPriority(MIN_PRIORITY);
		d2.setPriority(NORM_PRIORITY);
		//d1.setDaemon(true);
	}	
	
	public void run() {
		for(int i=1; i<=5; i++) {
//			System.out.println(Thread.currentThread().getName()+ " "+i);
			System.out.println(Thread.currentThread() + " "+i);
			try {
				Thread.sleep(1000);// 1000 ms - 1sec
			} 
			catch (InterruptedException e) {
				e.printStackTrace();
			} 
		}
	}	
}