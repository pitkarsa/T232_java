package day1;

public class Demo1 extends Thread {
	
	public static void main(String[] args) {
		// parallel execution
		Demo1 d1 = new Demo1();// thread
		Demo1 d2 = new Demo1();// thread
		d1.start(); // starting the thread
		d2.start(); // starting the thread
	}	
	
	public void run() {
		for(int i=1; i<=5; i++) {
			System.out.println(i);
			try {
				Thread.sleep(1000);// 1000 ms - 1sec
			} catch (InterruptedException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			} 
		}
	}
}